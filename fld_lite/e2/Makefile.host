# Host side of E2 (build on the card host; needs ../e1/prm.h and the OFED mlx5_ifc headers it copies)
KVER ?= $(shell uname -r)
IFC  ?= /usr/src/ofa_kernel/x86_64/$(KVER)/include/linux/mlx5
XRT  ?= /opt/xilinx/xrt

e2_host: e2_host.cpp devx_rx.o
	g++ -std=c++17 -O2 -Wall -Wno-address-of-packed-member -o $@ e2_host.cpp devx_rx.o -I$(XRT)/include -L$(XRT)/lib \
	    -lxrt_coreutil -libverbs -lmlx5 -Wl,-rpath,$(XRT)/lib
devx_rx.o: devx_rx.c devx_rx.h ../e1/prm.h mlx5_ifc.h
	gcc -std=gnu11 -O2 -Wall -I../e1 -c devx_rx.c
mlx5_ifc.h:
	cp $(IFC)/mlx5_ifc.h $(IFC)/mlx5_ifc_fpga.h .
clean:
	rm -f e2_host devx_rx.o mlx5_ifc.h mlx5_ifc_fpga.h
