# Host side of E3 (build on the card host; reuses ../e1/prm.h, ../e1/devx_sq.c and the OFED mlx5_ifc headers)
XRT ?= /opt/xilinx/xrt

e3_host: e3_host.cpp devx_cq.o devx_sq.o
	g++ -std=c++17 -O2 -Wall -Wno-address-of-packed-member -I../e1 -o $@ e3_host.cpp devx_cq.o devx_sq.o \
	    -I$(XRT)/include -L$(XRT)/lib -lxrt_coreutil -libverbs -lmlx5 -Wl,-rpath,$(XRT)/lib
devx_cq.o: devx_cq.c devx_cq.h ../e1/prm.h
	gcc -std=gnu11 -O2 -Wall -I../e1 -c devx_cq.c
devx_sq.o: ../e1/devx_sq.c ../e1/devx_sq.h ../e1/prm.h
	gcc -std=gnu11 -O2 -Wall -I../e1 -c ../e1/devx_sq.c -o $@
clean:
	rm -f e3_host e3_echo_host devx_cq.o devx_sq.o devx_rx.o

e3_echo_host: e3_echo_host.cpp devx_cq.o devx_sq.o devx_rx.o
	g++ -std=c++17 -O2 -Wall -Wno-address-of-packed-member -I../e1 -I../e2 -o $@ e3_echo_host.cpp devx_cq.o devx_sq.o devx_rx.o \
	    -I$(XRT)/include -L$(XRT)/lib -lxrt_coreutil -libverbs -lmlx5 -Wl,-rpath,$(XRT)/lib
devx_rx.o: ../e2/devx_rx.c ../e2/devx_rx.h ../e1/prm.h
	gcc -std=gnu11 -O2 -Wall -I../e1 -c ../e2/devx_rx.c -o $@
