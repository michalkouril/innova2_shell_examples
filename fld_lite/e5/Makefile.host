# Host programs of FLD-lite (build on the card host; the DevX helpers are in ../devx)
XRT ?= /opt/xilinx/xrt
CFLAGS_DEVX = -std=gnu11 -O2 -Wall -I../devx

e5_host: e5_host.cpp devx_cq.o devx_sq.o devx_rx.o
	g++ -std=c++17 -O2 -Wall -Wno-address-of-packed-member -I../devx -o $@ e5_host.cpp devx_cq.o devx_sq.o devx_rx.o \
	    -I$(XRT)/include -L$(XRT)/lib -lxrt_coreutil -libverbs -lmlx5 -Wl,-rpath,$(XRT)/lib
devx_cq.o: ../devx/devx_cq.c ../devx/devx_cq.h ../devx/prm.h
	gcc $(CFLAGS_DEVX) -c ../devx/devx_cq.c -o $@
devx_sq.o: ../devx/devx_sq.c ../devx/devx_sq.h ../devx/prm.h
	gcc $(CFLAGS_DEVX) -c ../devx/devx_sq.c -o $@
devx_rx.o: ../devx/devx_rx.c ../devx/devx_rx.h ../devx/prm.h
	gcc $(CFLAGS_DEVX) -c ../devx/devx_rx.c -o $@
clean:
	rm -f e5_host devx_cq.o devx_sq.o devx_rx.o

e5gen_host: e5gen_host.cpp devx_cq.o devx_sq.o devx_rx.o
	g++ -std=c++17 -O2 -Wall -Wno-address-of-packed-member -Wno-misleading-indentation -I../devx -o $@ e5gen_host.cpp devx_cq.o devx_sq.o devx_rx.o \
	    -I$(XRT)/include -L$(XRT)/lib -lxrt_coreutil -libverbs -lmlx5 -Wl,-rpath,$(XRT)/lib

# UDP endpoint: FLD-lite + udp_swap echo; RX rule {IPv4, UDP, dst ip, dport, !frag} + TAG (devx_rx_s0)
devx_rx_s0.o: ../devx/devx_rx_s0.c ../devx/devx_rx_s0.h ../devx/prm.h
	gcc $(CFLAGS_DEVX) -c ../devx/devx_rx_s0.c -o $@
e5udp_host: e5udp_host.cpp devx_cq.o devx_sq.o devx_rx_s0.o
	g++ -std=c++17 -O2 -Wall -Wno-address-of-packed-member -I../devx -o $@ e5udp_host.cpp devx_cq.o devx_sq.o devx_rx_s0.o \
	    -I$(XRT)/include -L$(XRT)/lib -lxrt_coreutil -libverbs -lmlx5 -Wl,-rpath,$(XRT)/lib
