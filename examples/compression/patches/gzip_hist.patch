+template <int MAX_MATCH_LEN, int BLOCKSIZE = 32768, int BOOSTER_OFFSET_WINDOW = 16 * 1024, int LEFT_BYTES = 64>
+void lzBoosterHist(hls::stream<IntVectorStream_dt<32, 1> >& inStream, hls::stream<ap_uint<16> >& histLenStream,
