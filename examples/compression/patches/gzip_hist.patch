+// innova2: one core's input for multicoreDistributorHist -- its history words, then its block's words
+template <int FREQ_DWIDTH = 32, int DWIDTH = 64>
+void histConcat(hls::stream<ap_uint<DWIDTH> >& histStream,
+                hls::stream<ap_uint<16> >& histLenStream,
+                hls::stream<ap_uint<DWIDTH> >& blockStream,
+                hls::stream<ap_uint<FREQ_DWIDTH> >& sizeStream,
+                hls::stream<ap_uint<DWIDTH> >& outStream,
+                hls::stream<ap_uint<FREQ_DWIDTH> >& outSizeStream) {
+    constexpr int incr = DWIDTH / 8;
+    for (ap_uint<FREQ_DWIDTH> size = sizeStream.read(); size != 0; size = sizeStream.read()) {
+        outSizeStream << size;
+        const ap_uint<16> hw = histLenStream.read() / incr;
+        const ap_uint<FREQ_DWIDTH> words = (size - 1) / incr + 1;
+    histConcatHistory:
+        for (ap_uint<16> i = 0; i < hw; i++) {
+#pragma HLS PIPELINE II = 1
+            outStream << histStream.read();
+        }
+    histConcatBlock:
+        for (ap_uint<FREQ_DWIDTH> i = hw; i < words; i++) {
+#pragma HLS PIPELINE II = 1
+            outStream << blockStream.read();
+        }
+    }
+    outSizeStream << 0;
+}
