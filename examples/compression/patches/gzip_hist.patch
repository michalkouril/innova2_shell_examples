+// joins them in front of the core, so neither stream stalls the distributor.
+template <int FREQ_DWIDTH = 32, int DWIDTH = 64, int NUM_BLOCKS = 8, int BLOCK_SIZE = 32768, int HIST = 8192,
+          int MIN_BLCK_SIZE = 64>
+void multicoreDistributorHist(hls::stream<ap_uint<DWIDTH> >& inStream,
+                              hls::stream<uint32_t>& inSizeStream,
+                              hls::stream<ap_uint<DWIDTH> >& strdStream,
+                              hls::stream<ap_uint<16> >& strdSizeStream,
+                              hls::stream<ap_uint<DWIDTH> > distStream[NUM_BLOCKS],
+                              hls::stream<ap_uint<FREQ_DWIDTH> > distSizeStream[NUM_BLOCKS],
+                              hls::stream<ap_uint<16> > histLenStream[NUM_BLOCKS],
+                              hls::stream<ap_uint<DWIDTH> > histStream[NUM_BLOCKS],
+                              hls::stream<ap_uint<16> > histLenCatStream[NUM_BLOCKS]) {
+    constexpr int incr = DWIDTH / 8;
+    constexpr int c_histWords = HIST / incr;
+    static_assert((BLOCK_SIZE / incr) % c_histWords == 0, "the history must divide the block");
+    ap_uint<DWIDTH> hbuf[c_histWords];
