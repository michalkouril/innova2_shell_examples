+    while (readSize < inputSize) {
+        core %= NUM_BLOCKS;
+        ap_uint<FREQ_DWIDTH> outputSize = ((readSize + BLOCK_SIZE) > inputSize) ? (inputSize - readSize) : BLOCK_SIZE;
+        bool storedBlockFlag = (outputSize <= MIN_BLCK_SIZE);
+        readSize += outputSize;
+        if (storedBlockFlag) {
+            strdSizeStream << outputSize;
+        multicoreDistributorStored:
+            for (ap_uint<FREQ_DWIDTH> j = 0; j < outputSize; j += incr) {
+#pragma HLS PIPELINE II = 1
+                strdStream << inStream.read();
+            }
+        } else {
+            const ap_uint<16> h = haveHist ? HIST : 0;
+            distSizeStream[core] << (ap_uint<FREQ_DWIDTH>)(outputSize + h);
+            histLenStream[core] << h;
+            histLenCatStream[core] << h;
+        multicoreDistributorHistory:
+            for (int j = 0; j < (haveHist ? c_histWords : 0); j++) {
+#pragma HLS PIPELINE II = 1
+                histStream[core] << hbuf[j];
+            }
+        multicoreDistributorBlock:
+            for (ap_uint<FREQ_DWIDTH> j = 0, w = 0; j < outputSize; j += incr, w++) {
+#pragma HLS PIPELINE II = 1
+                ap_uint<DWIDTH> outData = inStream.read();
