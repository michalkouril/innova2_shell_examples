+            uint8_t tLen = inValue.range(15, 8);
+            uint16_t tOffset = inValue.range(31, 16);
+
+            if (tOffset < c_boosterOffsetWindow) {
+                boostFlag = true;
+            } else {
+                boostFlag = false;
+            }
+            uint8_t match_ch = nextMatchCh;
+            local_mem[iIdx % c_boosterOffsetWindow] = tCh;
